# ============================================================
# AWS SECRETS MANAGER (ECS / Production)
# Set AWS_SECRET_NAME to load ALL secrets below from AWS
# instead of this file. Leave unset for local dev (.env used).
# ============================================================
# AWS_SECRET_NAME=aipe-dashboard/dev/app-secrets
# AWS_REGION=us-east-1

# ============================================================
# REQUIRED - Application will NOT start without these
# ============================================================

# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/devsecops-jira

# Fernet private key for token decryption (must be valid base64)
TOKEN_PRIVATE_KEY=ooczhi1zd0r98nDqc_c76evynlcevqeAoJTF6LTjajY=

# Jira instance URL and API credentials
JIRA_BASE_URL=https://zeb-ai.atlassian.net
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_SERVICE_ACCOUNT_EMAIL=svc_jira.tools@zeb.co

# ============================================================
# OPTIONAL - Needed for ServiceNow sync endpoint
# ============================================================
SERVICENOW_ALLOWED_EMAIL=servicenow@your-org.com

# ============================================================
# EMAIL NOTIFICATION - Microsoft Graph API
# ============================================================
GRAPH_CLIENT_ID=your-azure-app-client-id
GRAPH_CLIENT_SECRET=your-azure-app-client-secret
GRAPH_TENANT_ID=your-azure-tenant-id
GRAPH_SENDER_EMAIL=noreply@your-org.com

# ============================================================
# EMAIL NOTIFICATION - AWS S3 (PDF report storage)
# ============================================================
S3_BUCKET_NAME=devsecops-reports-bucket
AWS_REGION=us-east-1
S3_URL_EXPIRY_DAYS=7

# ============================================================
# AZURE DEVOPS SYNC
# ============================================================
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=your-personal-access-token
ADO_SYNC_CONCURRENCY=5
ADO_SYNC_RECORD_LIMIT=5

# ============================================================
# JIRA LABS HUB INTEGRATION (mark_not_applicable)
# ============================================================
JIRA_LABS_HUB_PROJECT_KEY=SBT
JIRA_LABS_HUB_PROJECT_ID=12432
