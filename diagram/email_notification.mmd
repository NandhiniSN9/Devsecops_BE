sequenceDiagram
    title ZDAD-60: Email Notification Service

    participant Cron as External Cron Trigger
    participant Route as Route<br/>(src/routes/report_route.py)
    participant Service as Service<br/>(src/services/report_service.py)
    participant Repository as Repository<br/>(src/repositories/)
    participant Database
    participant Storage as AWS S3
    participant Email as Microsoft Graph API

    %% Trigger
    Cron->>Route: POST /api/v1/reports/generate<br/>(no request body)
    Route->>Service: Trigger report generation

    %% Fetch all specializations
    Service->>Repository: Fetch all active specializations
    Repository->>Database: SELECT * FROM specializations<br/>WHERE is_active = 1
    Database-->>Repository: Active specializations list
    Repository-->>Service: Specializations

    loop For each active specialization
        %% Cron Job Tracking
        Service->>Repository: Create cron job record
        Repository->>Database: INSERT INTO cron_jobs<br/>(type="email", sync_status="pending")
        Database-->>Repository: cron_id created
        Repository-->>Service: cron_id

        %% Frequency Evaluation
        Service->>Repository: Fetch settings for specialization
        Repository->>Database: SELECT settings<br/>WHERE specialization_id matches
        Database-->>Repository: {email_digest, at_risk_alert, setting_id}
        Repository-->>Service: Settings
        Service->>Repository: Fetch last email history
        Repository->>Database: SELECT email_history<br/>WHERE setting_id AND email_type<br/>AND email_status="sent"<br/>ORDER BY last_synced DESC LIMIT 1
        Database-->>Repository: Last sent timestamp (or null)
        Repository-->>Service: Last sent record
        Service->>Service: Evaluate frequency window<br/>(daily=24h, weekly=7d, bi-weekly=14d, monthly=30d)

        alt Report already sent within window
            Service->>Service: Skip - log DEBUG
        else Report is due
            %% Fetch Template and Data
            Service->>Repository: Fetch email template
            Repository->>Database: SELECT template_content FROM email_templates<br/>WHERE template_name = report_type
            Database-->>Repository: HTML template string
            Repository-->>Service: Template

            alt Summary report
                Service->>Repository: Fetch KPI data
                Repository->>Database: SELECT kpi_history<br/>WHERE specialization_id matches
                Database-->>Repository: KPI metrics data
                Repository-->>Service: Report data
            else At-risk report
                Service->>Repository: Fetch at-risk projects
                Repository->>Database: SELECT projects WHERE<br/>days since onboarding > threshold
                Database-->>Repository: At-risk project list
                Repository-->>Service: Report data
            end

            %% Fetch Recipients
            Service->>Repository: Fetch recipients
            Repository->>Database: SELECT alert_recipient FROM email_recipient<br/>WHERE specialization_id AND is_active = 1
            Database-->>Repository: Recipient email list
            Repository-->>Service: Recipients

            alt No active recipients
                Service->>Service: Log WARNING, skip specialization
                Service->>Repository: Update cron job status
                Repository->>Database: UPDATE cron_jobs SET sync_status="fail"
            else Recipients found
                %% PDF Generation
                Service->>Service: Parse HTML with BeautifulSoup<br/>Inject report data into placeholders
                Service->>Service: Convert HTML to PDF with WeasyPrint<br/>(in-memory)

                %% Upload to Storage
                Service->>Storage: Upload PDF bytes<br/>Path: reports/{spec}/{type}/{date}.pdf
                Storage-->>Service: Pre-signed download URL

                %% Send Emails
                loop For each recipient
                    Service->>Email: Send email with report link
                    alt Success
                        Email-->>Service: 200 OK
                    else Failed
                        Email-->>Service: Error
                        Service->>Service: Log WARNING, continue
                    end
                end

                %% Track History
                alt At least one email sent
                    Service->>Repository: Record success
                    Repository->>Database: INSERT INTO email_history<br/>(email_status="sent", report_url, email_type)
                else All failed
                    Service->>Repository: Record failure
                    Repository->>Database: INSERT INTO email_history<br/>(email_status="failed", email_type)
                end

                Service->>Repository: Update cron job status
                Repository->>Database: UPDATE cron_jobs SET sync_status="success"
            end
        end
    end

    Service-->>Route: Processing complete
    Route-->>Cron: 200 - Email sent successfully

    %% Error Scenario
    Note over Route,Database: On unhandled exception
    Service->>Repository: Log error
    Repository->>Database: INSERT INTO error_log<br/>(error_message, error_function, stack_trace)
    Service->>Repository: Update cron job
    Repository->>Database: UPDATE cron_jobs SET sync_status="fail"
    Route-->>Cron: 500 - Internal Server Error
